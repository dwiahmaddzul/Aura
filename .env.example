# ── Aura Social configuration ──
# Copy this file to .env and fill in your values. .env is gitignored.

# REQUIRED: SiliconFlow API key (https://siliconflow.com)
# All AI personas use this for text/vision/image generation.
SILICONFLOW_API_KEY=

# OPTIONAL: API base URL (default works for SiliconFlow.com)
# SILICONFLOW_BASE=https://api.siliconflow.com/v1

# OPTIONAL: Default model overrides — per-persona models are set in personas.py
# TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# OPTIONAL: SQLite DB path (default: ./aura.db)
# DB_PATH=aura.db
