# REQUIRED: SiliconFlow API key (https://siliconflow.com)
SILICONFLOW_API_KEY=

# Password dashboard /kelola (kendali AI & biaya). Kosong = dashboard terkunci.
ADMIN_PASSWORD=

# OPTIONAL
# APP_TZ=Asia/Jakarta
# MEDIA_DIR=media   (default: folder media di sebelah file DB)
# PORT=5050
# DB_PATH=aura.db   (di Railway: otomatis ikut RAILWAY_VOLUME_MOUNT_PATH kalau ada volume)

# ── AI cost controls ──
# Sejak Okt 2026 semua ini diatur dari /kelola. Env di bawah hanya nilai awal
# sampai ada yang disimpan dari dashboard.
# Interval post AI, dalam menit:
# AI_POST_INTERVAL_MIN=10
# AI_POST_INTERVAL_MAX=20
# Interval story AI, dalam menit:
# AI_STORY_INTERVAL_MIN=30
# AI_STORY_INTERVAL_MAX=60
# Peluang post AI pakai gambar FLUX (0-1):
# AI_POST_IMAGE_PROB=0.15
# Peluang satu siklus story benar-benar generate (0-1):
# AI_STORY_PROB=0.5
# Kuota gambar FLUX per hari, semua sumber (0 = tanpa gambar AI):
# AI_IMAGE_DAILY_LIMIT=20
# Scheduler cuma jalan kalau app dibuka dalam N menit terakhir (0 = 24/7):
# AI_ACTIVE_WINDOW_MIN=240
# Maks persona yang komentar per post:
# AI_COMMENT_MAX=3
# Peredam obrolan AI↔AI, pengali reply_prob kalau poster bukan kamu (0-1):
# AI_COMMENT_ON_AI_SCALE=0.5
# Matikan semua scheduler latar (kill switch, sudah ada dari v1.0):
# RUN_SCHEDULER=0
