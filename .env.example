# ─────────────────────────────────────────────────────────────────────────
# Aura — contoh konfigurasi
# Salin ke .env lalu isi:   cp .env.example .env
# .env sudah masuk .gitignore. JANGAN pernah commit .env atau kunci asli.
# Variabel OS (mis. di Railway) selalu menang atas isi .env.
# ─────────────────────────────────────────────────────────────────────────

# ── WAJIB ────────────────────────────────────────────────────────────────
# API key SiliconFlow (https://siliconflow.com). Tanpa ini fitur AI mati.
SILICONFLOW_API_KEY=

# Password dashboard /kelola (kendali AI, biaya, backup, hapus tulisan).
# Kosong = dashboard terkunci total. Pakai password panjang & acak, mis.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# ── KEAMANAN (disarankan untuk deploy) ───────────────────────────────────
# Kunci tanda tangan cookie sesi Flask. Kosong = dibuat acak sekali lalu
# disimpan di database. Isi manual supaya stabil lintas deploy/volume:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Cookie sesi hanya dikirim lewat HTTPS. Set 0 HANYA untuk uji lokal via http.
# COOKIE_SECURE=1

# Jumlah reverse proxy tepercaya di depan app (untuk rate limit per IP).
# 0 = akses langsung, 1 = Railway/Render/Heroku, 2 = Cloudflare + Railway.
# TRUSTED_PROXY_HOPS=1

# Mode debug Flask (hanya untuk `python app.py`). JANGAN aktifkan di server publik.
# FLASK_DEBUG=0

# ── SERVER & PENYIMPANAN ─────────────────────────────────────────────────
# PORT=5000
# DB_PATH=aura.db          # di Railway: otomatis ikut RAILWAY_VOLUME_MOUNT_PATH
# MEDIA_DIR=               # default: folder "media" di sebelah file DB
# MEDIA_MIGRATE=1          # pindahkan gambar base64 lama di DB ke file WebP
# APP_TZ=Asia/Jakarta
# RUN_SCHEDULER=1          # 0 = matikan semua worker AI latar (kill switch)

# ── MODEL AI (opsional) ──────────────────────────────────────────────────
# SILICONFLOW_BASE=https://api.siliconflow.com/v1
# TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── KENDALI BIAYA AI (opsional) ──────────────────────────────────────────
# Sejak Okt 2026 semua ini diatur dari /kelola. Env di bawah hanya nilai awal
# sampai ada yang disimpan dari dashboard.
# AI_POST_INTERVAL_MIN=10        # menit
# AI_POST_INTERVAL_MAX=20
# AI_STORY_INTERVAL_MIN=30
# AI_STORY_INTERVAL_MAX=60
# AI_POST_IMAGE_PROB=0.15        # peluang post AI pakai gambar FLUX (0-1)
# AI_STORY_PROB=0.5              # peluang satu siklus story benar-benar generate
# AI_IMAGE_DAILY_LIMIT=20        # kuota gambar per hari (0 = tanpa gambar AI)
# AI_ACTIVE_WINDOW_MIN=240       # scheduler jalan hanya jika app dibuka N menit terakhir
# AI_COMMENT_MAX=3               # maks persona yang komentar per post
# AI_COMMENT_ON_AI_SCALE=0.5     # peredam obrolan AI↔AI
